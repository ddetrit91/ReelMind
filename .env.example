# --- Local: SQLite file via libSQL ---
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# --- Production (Vercel): Turso cloud ---
# TURSO_DATABASE_URL=libsql://your-db-name-org.turso.io
# TURSO_AUTH_TOKEN=

# LLM — at least one recommended for categories + semantic search
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Strong secret in production (header x-ingest-secret for external ingest)
INGEST_SECRET=dev-secret

USE_MOCK_DATA=false

# First admin: used by npm run db:seed / admin:sync and on login (server action)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Optional Instagram oEmbed thumbnail
META_OEMBED_ACCESS_TOKEN=
